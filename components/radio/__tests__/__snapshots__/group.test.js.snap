exports[`Radio all children should have a name property 1`] = `<div class="xy-radio-group xy-radio-group-outline"><label class="xy-radio-wrapper"><span class="xy-radio"><input name="radiogroup" type="radio" class="xy-radio-input" value="A"><span class="xy-radio-inner"></span></span><span>A</span></label><label class="xy-radio-wrapper"><span class="xy-radio"><input name="radiogroup" type="radio" class="xy-radio-input" value="B"><span class="xy-radio-inner"></span></span><span>B</span></label><label class="xy-radio-wrapper"><span class="xy-radio"><input name="radiogroup" type="radio" class="xy-radio-input" value="C"><span class="xy-radio-inner"></span></span><span>C</span></label></div>`;

exports[`Radio fire change events when value changes 1`] = `<div class="xy-radio-group xy-radio-group-outline"><label class="xy-radio-wrapper"><span class="xy-radio"><input type="radio" class="xy-radio-input" value="A"><span class="xy-radio-inner"></span></span><span>A</span></label><label class="xy-radio-wrapper"><span class="xy-radio"><input type="radio" class="xy-radio-input" value="B"><span class="xy-radio-inner"></span></span><span>B</span></label><label class="xy-radio-wrapper"><span class="xy-radio"><input type="radio" class="xy-radio-input" value="C"><span class="xy-radio-inner"></span></span><span>C</span></label></div>`;

exports[`Radio fire change events when value changes 2`] = `<div class="xy-radio-group xy-radio-group-outline"><label class="xy-radio-wrapper xy-radio-wrapper-checked"><span class="xy-radio xy-radio-checked"><input type="radio" class="xy-radio-input" value="A"><span class="xy-radio-inner"></span></span><span>A</span></label><label class="xy-radio-wrapper"><span class="xy-radio"><input type="radio" class="xy-radio-input" value="B"><span class="xy-radio-inner"></span></span><span>B</span></label><label class="xy-radio-wrapper"><span class="xy-radio"><input type="radio" class="xy-radio-input" value="C"><span class="xy-radio-inner"></span></span><span>C</span></label></div>`;

exports[`Radio passes prefixCls down to radio 1`] = `<div class="my-radio-group my-radio-group-outline"><label class="my-radio-wrapper"><span class="my-radio"><input type="radio" class="my-radio-input" value="Apple"><span class="my-radio-inner"></span></span><span>Apple</span></label><label class="my-radio-wrapper"><span class="my-radio"><input type="radio" class="my-radio-input" value="Orange"><span class="my-radio-inner"></span></span><span>Orange</span></label></div>`;
