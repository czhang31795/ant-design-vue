{
  "name": "@czxingyu/antd-cli",
  "version": "4.3.9",
  "description": "MCP + setup for @czxingyu/ant-design-vue: AI queries real component APIs/demos; humans use the docs site",
  "keywords": [
    "ant-design-vue",
    "mcp",
    "agent",
    "skills",
    "antd"
  ],
  "bin": {
    "antd-cli": "bin/antd-cli.js"
  },
  "files": [
    "bin",
    "dist",
    "data",
    "skills",
    "README.md"
  ],
  "scripts": {
    "index": "tsx src/indexer/build-index.ts",
    "build": "npm run index && tsup src/index.ts src/mcp.ts --format cjs --outDir dist --clean --sourcemap --external @modelcontextprotocol/sdk --external zod",
    "dev": "tsx src/index.ts",
    "mcp": "tsx src/mcp.ts",
    "smoke:mcp": "node scripts/smoke-mcp.cjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "cac": "^6.7.14",
    "gray-matter": "^4.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.19.0",
    "tsup": "^8.3.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/czhang31795/ant-design-vue.git",
    "directory": "packages/antd-cli"
  },
  "publishConfig": {
    "access": "public"
  }
}
