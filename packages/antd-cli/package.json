{
  "name": "@czxingyu/antd-cli",
  "version": "4.3.2",
  "description": "Agent-friendly CLI to discover @czxingyu/ant-design-vue components, APIs and demos",
  "keywords": [
    "ant-design-vue",
    "cli",
    "agent",
    "skills",
    "antd"
  ],
  "bin": {
    "antd-cli": "./bin/antd-cli.js"
  },
  "files": [
    "bin",
    "dist",
    "data",
    "skills",
    "README.md"
  ],
  "scripts": {
    "index": "tsx src/indexer/build-index.ts",
    "build": "npm run index && tsup src/index.ts --format cjs --outDir dist --clean --sourcemap",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.19.0",
    "tsup": "^8.3.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/czhang31795/ant-design-vue.git",
    "directory": "packages/antd-cli"
  },
  "publishConfig": {
    "access": "public"
  }
}
